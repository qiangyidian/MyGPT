# =============================================================================
# AI Chat Platform — environment template. Copy to `.env` and adjust.
# =============================================================================

# ---- App ----
ENV=dev                       # dev | prod
AUTO_CREATE_TABLES=true       # create tables from metadata on startup (dev convenience)
BACKEND_CORS_ORIGINS=http://localhost:3000
# Host ports for frontend/backend (override if a port is already in use locally)
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Security ----
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Fernet key for encrypting stored API keys. Generate your OWN and keep it
# stable/backed-up (keys encrypted with one FERNET_KEY cannot be decrypted with
# another):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave EMPTY in dev to auto-generate a per-process key (NOT for production —
# keys become undecryptable on restart). Non-dev deployments MUST set this
# (startup refuses to boot otherwise).
FERNET_KEY=
# 零停机轮换（逗号分隔，**新键在前**）：第一个键负责加密此后写入的内容，其余
# 只用于解密历史密文。轮换 = 发布 FERNET_KEYS=新,旧 且让 FERNET_KEY 继续指向要
# 退役的旧键；两者都设时 FERNET_KEYS 优先。
# FERNET_KEYS=

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_chat

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Vector DB ----
VECTOR_DB=qdrant              # qdrant | pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=              # optional
QDRANT_EMBEDDING_DIM=1024    # must match your embedding model's output dim

# ---- Default model (used to seed a system model config + as fallback) ----
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=your-api-key
MODEL_NAME=my-model
# Embedding model
EMBEDDING_API_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=your-api-key
EMBEDDING_MODEL_NAME=my-embedding-model

# ---- Storage / uploads ----
# 只有 local 可用。MinIO/S3 后端**没有实现**（app/core/storage.py 里那条分支直接
# raise），写成 minio 会在启动检查就被拒 —— 因为过去它是「上传时才炸」，用户看到的
# 是 500，而部署者以为对象存储已经生效。
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=20
# 留空即用代码里的默认清单（与解析器注册表同源，见 backend/app/core/config.py）。
# 只有需要**收窄**时才设置；写了但没有对应解析器的扩展名会被忽略并打一条 warning。
# ALLOWED_UPLOAD_EXT=.pdf,.docx,.txt,.md
# MinIO（**当前无效**：后端未实现，这几项只是留给未来的字段，设了也不会被读）
# MINIO_ENDPOINT=minio:9000
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=ai-chat

# ---- RAG defaults ----
# 每个知识库可在「知识库设置」里单独覆盖 top_k / 阈值 / 重排 / 切分；留空即沿用
# 这里的平台默认值。
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5
# 注入提示词的知识库上下文总 token 上限（0 = 不限）。top_k 只限块数，不限长度。
RAG_CONTEXT_TOKENS=6000
# 关键词召回的候选块上限：候选选择走 ILIKE，打分在 Python，这一列限定每轮 CPU。
RAG_KEYWORD_CANDIDATES=400

# ---- 文档摄取队列（持久：租约 + 退避 + 崩溃接管）----
# 上传/重建只把 documents 行排队，真正的索引由 worker 循环领取（API 进程与
# app.worker 都会跑）。租约到期即可被别的进程接手，因此发版/崩溃不会把文档
# 永远留在 pending；次数用尽后转为 failed，坏文件不会再被无限重试。
INGEST_LEASE_TTL_SECONDS=300
INGEST_LEASE_RENEW_SECONDS=60
INGEST_MAX_ATTEMPTS=4
INGEST_BACKOFF_BASE_SECONDS=30
INGEST_POLL_INTERVAL_SECONDS=3

# ---- 检索质量评测（app/evals/rag_*.py，随 release-eval-gate 一起跑）----
# 离线那一遍用仓库内的 golden set + BM25 基线，任何凭证都不需要，永远会跑。
# 下面两项只在跑「真·混合检索」那一遍时才需要：先建一个知识库、把
# app/evals/golden/rag_retrieval.v1.json 里同名文档上传进去，再填 KB id。
# EVAL_RAG_GOLDEN_PATH=/path/to/bigger-golden.json
# EVAL_RAG_KB_IDS=00000000-0000-0000-0000-000000000000
# 文档级 recall@k 的在线底线（默认 0.8；离线那一遍的门禁写在 Thresholds 里）。
# EVAL_RAG_MIN_RECALL=0.8

# ---- Web search (web_search tool; powers the "来源" panel's real web sources) ----
# DuckDuckGo HTML scraping is the no-config default but is blocked in some
# networks (e.g. mainland CN). Point WEB_SEARCH_ENDPOINT at a JSON-returning
# search endpoint you can reach, and the "来源" panel will list real results.
#   SearXNG (GET, no key): WEB_SEARCH_ENDPOINT=http://localhost:8080/search
#   Bing v7 (GET):         WEB_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
#                          WEB_SEARCH_API_KEY=<your-key>
#   Tavily (POST):         WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
#                          WEB_SEARCH_API_KEY=<tvly-...>  WEB_SEARCH_METHOD=post
#   Serper (POST):         WEB_SEARCH_ENDPOINT=https://google.serper.dev/search
#                          WEB_SEARCH_API_KEY=<key>       WEB_SEARCH_METHOD=post
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_SEARCH_METHOD=get        # get | post
WEB_SEARCH_DEPTH=advanced    # Tavily only: basic | advanced (advanced = deeper, higher quality)

# ---- Background tasks ----
# dev:     inprocess — FastAPI BackgroundTasks (single-process; NOT for prod).
# prod:    durable   — the API only enqueues to a Redis Streams run queue; the
#          separate `worker` service (docker-compose.prod.yml / deploy/k8s)
#          consumes it, and `recovery` reclaims expired leases. Requires a
#          reachable REDIS_URL. See app/worker.py + app/recovery.py.
BACKGROUND_WORKER=inprocess

# ---- 持久运行队列（durable 模式才用得到）----
# API 只 XADD 入队，worker 进程消费，recovery 回收过期租约。下面几项决定的是
# 「一次崩溃最多丢多少进度」，不是性能：
# 租约：worker 持有一个 run 的时间上限，超时即可被别的进程接手（发版/崩溃不会把
# run 永远留在 running）。RENEW 必须明显小于 TTL，否则续租来不及就被人抢走。
RUN_LEASE_TTL_SECONDS=120
RUN_LEASE_RENEW_SECONDS=30
# 流的上限（XADD ~maxlen）。每条 run 都会留一条流记录，没有上限 = Redis 随实例
# 生命周期无限增长。近似裁剪只裁整节点，所以便宜；PEL 里未 ack 的记录不会被裁掉。
RUN_STREAM_MAXLEN=100000
# 空闲超过这个时间的 PEL 记录会被 XAUTOCLAIM 收回并重新入队 —— 这是租约/恢复路径
# 看不见的那个崩溃窗口（worker 死在 XREADGROUP 之后、写租约之前）。
RUN_STREAM_CLAIM_IDLE_SECONDS=120
# 一次扫描能看到的 PEL 条数。这是**正确性**窗口而不是性能窗口：超出上限的记录
# 看不见，于是同一条 run 会被再 XADD 一遍（重复执行），而 de-dup 正是为此存在。
# 积压比这大就把它调大。
RUN_STREAM_PENDING_SCAN=1000
# 单条 run 最多重试几次，用尽后转 failed（坏任务不再无限重试烧钱）。
RUN_MAX_RETRIES=3
# 队列深度采样间隔（秒）：PROMETHEUS_ENABLED 时喂给 /metrics 的 gauge + 告警。
RUN_QUEUE_DEPTH_POLL_SECONDS=15

# ---- 语音输入 (ASR) / 语音播报 (TTS) ----
# 总开关：默认关闭。关闭时 POST /api/speech/transcribe 与 /api/speech/synthesize
# 在任何出站调用之前返回中文 503，GET /api/speech/capabilities 也会把
# asr_enabled / tts_enabled 报成 false —— 前端的麦克风/喇叭按钮据此置灰。
SPEECH_ENABLED=false
# 用哪个模型做转写/合成：填 ModelConfig 的 UUID（设置 → 模型 里那一行）。
# 留空 = 自动挑选：先按能力位 supports_audio_input / supports_audio_output 过滤，
# 再优先命中下面关键字的模型名。注意：**不要在这里放厂商 API Key** —— 密钥存在
# ModelConfig 行里（Fernet 加密），浏览器永远拿不到它，也不会直连厂商。
# SPEECH_ASR_MODEL_ID=
# SPEECH_TTS_MODEL_ID=
# SPEECH_ASR_MODEL_KEYWORDS=whisper,paraformer,sensevoice,gpt-4o-transcribe,audio
# SPEECH_TTS_MODEL_KEYWORDS=tts,cosyvoice,sambert,gpt-4o-tts,audio
# 单次转写的音频体积上限（服务端在读取阶段截断，谎报 Content-Length 无效）
SPEECH_MAX_AUDIO_MB=10
# 录音时长上限（秒）：透出给前端让 MediaRecorder 到点自动停止，同时钳制计费估算
SPEECH_MAX_DURATION_SECONDS=120
# 单次播报的文本长度上限（字符）
SPEECH_MAX_TEXT_CHARS=4000
# 合成结果体积上限（provider 层只能整段返回音频，所以要显式封顶）
SPEECH_MAX_SYNTH_MB=25
# OpenAI 兼容 /audio/speech 的音色与格式（mp3|wav|opus|aac|flac|pcm）
SPEECH_TTS_VOICE=alloy
SPEECH_TTS_RESPONSE_FORMAT=mp3
# /audio/transcriptions 的 language（留空 = 模型自判；中文市场一般设 zh）
SPEECH_ASR_LANGUAGE=
# 用量估算（transcribe/speak 的响应里没有 usage 字段，只能服务端估算后再进
# MODEL_PRICING_JSON 与同一套积分/配额结算）
SPEECH_ASR_TOKENS_PER_MINUTE=1500
SPEECH_AUDIO_BITS_PER_SECOND=48000

# ---- Superuser (created on first startup if missing) ----
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# =============================================================================
# PRODUCTION-ONLY (set these in a separate .env.prod, never committed)
# Used by docker-compose.prod.yml (`--env-file .env.prod`) + deploy/k8s.
# The app refuses to boot with ENV=prod unless FERNET_KEY is non-empty and
# ADMIN_PASSWORD is changed from the default (see app/core/config.py validator).
# =============================================================================
# ENV=prod
# AUTO_CREATE_TABLES=false         # prod uses Alembic (the `migrate` one-shot /
#                                  # initContainer runs `alembic upgrade head`)
# # Stable Fernet key for encrypting stored API keys (REQUIRED, non-empty):
# #   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=<long-random-fernet-key>
# # Strong, unique DB password (referenced as a k8s Secret / .env.prod):
# POSTGRES_PASSWORD=<strong-password>
# ADMIN_PASSWORD=<changed-from-default>
# # Durable run queue (the `worker` + `recovery` services consume it):
# BACKGROUND_WORKER=durable
# # Multi-agent (CrewAI) runtime behind 专家模式 / deep research / debate.
# # Enabled by DEFAULT since crewai is a pinned dependency; set false to force
# # native single-agent everywhere (zero crewai imports).
# CREWAI_ENABLED=true
# # Production opts into multi-axis per-tenant caps (Task 11):
# QUOTAS_ENABLED=true
# # QUOTA_MAX_CONCURRENT_RUNS=8  QUOTA_MAX_TOKENS=1000000  QUOTA_MAX_COST_USD=50.0
# # Object storage: NOT available yet — STORAGE_BACKEND only accepts `local`
# # (the MinIO/S3 branch raises; see the Storage section above).
# STORAGE_BACKEND=local
# # Code-execution sandbox: docker (enterprise isolation; see sandbox-runner.yaml
# # DinD trade-off). `local` is dev/test ONLY.
# SANDBOX_MODE=docker
# # docker 模式必须有镜像，否则 runner 工厂直接拒绝构造（不放行=不执行）：
# # SANDBOX_DOCKER_IMAGE=python:3.12-slim
# # 资源上限（local 模式在施加不了硬限额的平台上按 fail-closed 拒绝执行）：
# # SANDBOX_CPU_SECONDS=30   SANDBOX_LOCAL_MEMORY_MB=512   SANDBOX_MAX_FSIZE_MB=64
# # SANDBOX_REQUIRE_LIMITS=true
# # docker 模式的容器硬限（内存/CPU 配额/进程数/单步墙钟/输出字节）：
# # SANDBOX_MEMORY_MB=512   SANDBOX_CPU_QUOTA=1.0   SANDBOX_PIDS_LIMIT=64
# # SANDBOX_TIMEOUT_SECONDS=30   SANDBOX_OUTPUT_LIMIT=8192
# # 工作区能力档案（决定 fs 读写/网络/根fs 只读；未知或不在白名单内 = 启动期报错）：
# # WORKSPACE_PERMISSION_PROFILE=:workspace-write
# # WORKSPACE_PROFILES_ALLOWED=            # 空 = 用内置白名单
# # EXEC_POLICY_FILE=                      # 允许/需审批/禁止 的 argv 前缀规则文件
# # 多 Agent 引擎灰度名单（只有总开关 AGENT_WORKFLOW_ENGINE=true 时生效）：
# # AGENT_WORKFLOW_ENGINE_PROFILES=deep_research
# # Statically-configured MCP servers offered to every run (Task 9); JSON array:
# # MCP_SERVERS=[{"name":"echo","command":"python","args":["-m","echo_server"],"transport":"stdio"}]
# MCP_SERVERS=
# # Observability exporters (probed with no-op fallback; set true for real exporters):
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=mygpt-backend
# PROMETHEUS_ENABLED=true
# LOG_REDACT_SENSITIVE=true
# # CORS for the prod frontend origin:
# BACKEND_CORS_ORIGINS=https://chat.example.com

# ---- Qdrant client/server pin (Task 13) -------------------------------------
# The server image is pinned to qdrant/qdrant:v1.12.x (docker-compose.yml +
# docker-compose.prod.yml). The client is pinned to 1.12.x or 1.13.x
# (backend/requirements.txt: qdrant-client>=1.12,<1.14) so the client/server
# minor-version skew stays <= 1. This resolves the known skew where an unpinned
# install pulled client 1.18.0 against server 1.12.4. health._check_qdrant
# asserts BOTH the server floor (>=1.10.0) AND client/server skew <= 1 at
# readiness, so a drifted client returns /ready -> 503 instead of passing
# silently. Bump both together, deliberately.

# ---- 运维加固（本次审查新增） ----
# X-Forwarded-For 可信代理网段（逗号分隔 CIDR）。仅这些代理提交的 XFF 会被用于
# 限流的客户端 IP 解析；留空 = 环回 + RFC1918/docker 默认网段。
# TRUSTED_PROXIES=10.0.0.0/8,192.168.0.0/16

# 用户自配模型端点是否允许指向私网地址（vLLM/Ollama 内网自部署场景）。
# 默认 false：普通用户只能配置解析到公网的端点，管理员不受限（SSRF 防护）。
# ALLOW_PRIVATE_MODEL_ENDPOINTS=false

# Prometheus 指标暴露（GET /metrics）。生产建议开启并配置抓取。
# 默认关：开着它必须同时配好下面的 METRICS_TOKEN，否则生产启动失败。
# PROMETHEUS_ENABLED=true
# /metrics 的 Bearer token。指标里带路由模板、按租户的标签值和队列深度，公网入口
# 上匿名暴露等于送人一份侦察地图：生产开了 PROMETHEUS_ENABLED 却没设这个值，启动
# 直接失败。本地/开发抓取可不带 token。
# METRICS_TOKEN=

# API 文档面（/docs、/redoc、/openapi.json）。这三个一起把全部路由、参数与鉴权方式
# 公开出去，公网入口上就是一份现成的攻击地图，所以只有 dev/test 默认开着，生产默认
# 关。要临时排查可以显式打开；DOCS_ENABLED=false 也能在开发里验证关闭效果。
# DOCS_ENABLED=true

# 配额记账周期（秒，默认 30 天）与并发槽位超时（秒）。
# QUOTA_PERIOD_SECONDS=2592000
# QUOTA_RUN_TTL_SECONDS=3600

# 数据保留：审计日志（天）、终态 run 事件（天）、孤儿上传清扫开关。
# AUDIT_RETENTION_DAYS=365
# RUN_EVENT_RETENTION_DAYS=90
# ORPHAN_SWEEP_ENABLED=true

# 数据库连接池：每个 API / worker / recovery 进程都有独立连接池。
# 总连接上界约为进程数 × (DB_POOL_SIZE + DB_MAX_OVERFLOW)，还要为迁移和管理连接留余量。
DB_POOL_SIZE=6
DB_MAX_OVERFLOW=2
# Background worker and recovery processes each have a smaller independent pool.
DB_BACKGROUND_POOL_SIZE=3
DB_BACKGROUND_MAX_OVERFLOW=1

# ---- 微信公众号扫码登录（经 wechat-auth 服务）----
# MyChat 不直接对接微信：回调、回复文案、发码全部在独立服务 wechat-auth 里，
# 因为微信一个公众号只能配一个回调 URL，而多个产品共用同一个公众号。
# 这里只做「拿码换 openid」。详见 docs/wechat-login.md。
# WECHAT_AUTH_ENABLED=false
# 回环地址：该服务的应用侧接口刻意不公网暴露，这里必须保持私网地址。
# WECHAT_AUTH_BASE_URL=http://127.0.0.1:8020
# WECHAT_AUTH_APP_ID=mychat
# 取自 wechat-auth 的注册表 /etc/wxauth/apps.json，必须一致。
# 生产守卫：非 dev/test 环境下 WECHAT_AUTH_ENABLED=true 而它为空 —— 后端拒绝启动。
# WECHAT_AUTH_APP_SECRET=
# 关键词模式下展示的公众号账号二维码（带参数二维码不可用时使用）
# WECHAT_AUTH_LOGIN_QR_URL=/images/wechat-account-qrcode.jpg
# WECHAT_AUTH_DEFAULT_KEYWORD=验证码
# WECHAT_AUTH_TIMEOUT_SECONDS=5

# ---- Credits / redeem codes (预付费积分) ----
# 观察模式开关：false = 扣分记账但不拦截（上线初期用），true = 余额不足拒绝请求
CREDITS_ENFORCED=false
# 1 美元服务端实测成本折算多少积分
CREDITS_PER_USD=1000.0
# 未配置定价的模型每 1000 token 兜底扣多少积分
CREDITS_PER_1K_TOKENS_FALLBACK=1.0
# 注册赠送积分（0 = 不送）
CREDITS_SIGNUP_BONUS=0
# 单次管理员调分上限
CREDITS_MAX_ADJUST=10000000
# 单批兑换码生成上限
REDEEM_MAX_CODES_PER_BATCH=5000
# 兑换码哈希的 HMAC pepper。库里只存 6 位前缀 + HMAC 摘要，所以 pepper 是对抗
# 「拿到库的人离线暴力猜码」的唯一屏障（兑换码是不记名凭证，等价于现金）。
# 留空时回落成由 JWT_SECRET 派生——**dev/test 可以，prod 不行**：非 dev 环境下
# 为空、为仓库里的演示值、或短于 16 字符，后端会直接拒绝启动。
# 注意这个回落把两件事耦合了：轮换 JWT_SECRET 会让**所有未兑换的码同时失效**。
# 生产请显式设置一个独立随机值并单独备份。
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# REDEEM_CODE_PEPPER=
# 积分池水位 gauge 的采样间隔（秒）。故意留长：一次采样是对 credit_accounts 的
# 聚合扫描，而"某人刚扣到 0"的实时信号是拒绝计数器而不是这个 gauge。
CREDIT_POOL_POLL_SECONDS=300
