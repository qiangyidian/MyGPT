# =============================================================================
# AI Chat Platform — environment template. Copy to `.env` and adjust.
# =============================================================================

# ---- App ----
ENV=dev                       # dev | prod
AUTO_CREATE_TABLES=true       # create tables from metadata on startup (dev convenience)
BACKEND_CORS_ORIGINS=http://localhost:3000
# Host ports for frontend/backend (override if a port is already in use locally)
FRONTEND_PORT=3000
BACKEND_PORT=8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---- Security ----
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=7
# Fernet key for encrypting stored API keys. Generate your OWN and keep it
# stable/backed-up (keys encrypted with one FERNET_KEY cannot be decrypted with
# another):
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave EMPTY in dev to auto-generate a per-process key (NOT for production —
# keys become undecryptable on restart). Non-dev deployments MUST set this
# (startup refuses to boot otherwise).
FERNET_KEY=

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_chat

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Vector DB ----
VECTOR_DB=qdrant              # qdrant | pgvector
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=              # optional
QDRANT_EMBEDDING_DIM=1024    # must match your embedding model's output dim

# ---- Default model (used to seed a system model config + as fallback) ----
MODEL_PROVIDER=openai-compatible
MODEL_API_BASE_URL=http://localhost:8000/v1
MODEL_API_KEY=your-api-key
MODEL_NAME=my-model
# Embedding model
EMBEDDING_API_BASE_URL=http://localhost:8000/v1
EMBEDDING_API_KEY=your-api-key
EMBEDDING_MODEL_NAME=my-embedding-model

# ---- Storage / uploads ----
STORAGE_BACKEND=local        # local | minio
STORAGE_DIR=/data/uploads
MAX_UPLOAD_MB=20
ALLOWED_UPLOAD_EXT=.pdf,.docx,.doc,.txt,.md,.csv,.xlsx,.xls
# MinIO (optional)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai-chat

# ---- RAG defaults ----
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=80
RAG_TOP_K=5

# ---- Web search (web_search tool; powers the "来源" panel's real web sources) ----
# DuckDuckGo HTML scraping is the no-config default but is blocked in some
# networks (e.g. mainland CN). Point WEB_SEARCH_ENDPOINT at a JSON-returning
# search endpoint you can reach, and the "来源" panel will list real results.
#   SearXNG (GET, no key): WEB_SEARCH_ENDPOINT=http://localhost:8080/search
#   Bing v7 (GET):         WEB_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search
#                          WEB_SEARCH_API_KEY=<your-key>
#   Tavily (POST):         WEB_SEARCH_ENDPOINT=https://api.tavily.com/search
#                          WEB_SEARCH_API_KEY=<tvly-...>  WEB_SEARCH_METHOD=post
#   Serper (POST):         WEB_SEARCH_ENDPOINT=https://google.serper.dev/search
#                          WEB_SEARCH_API_KEY=<key>       WEB_SEARCH_METHOD=post
WEB_SEARCH_ENDPOINT=
WEB_SEARCH_API_KEY=
WEB_SEARCH_METHOD=get        # get | post

# ---- Background tasks ----
# dev: in-process FastAPI BackgroundTasks. prod: point to a Redis queue (Celery/RQ) later.
BACKGROUND_WORKER=inprocess

# ---- Superuser (created on first startup if missing) ----
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123
